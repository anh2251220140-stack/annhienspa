# Optional Compose overrides only; contains no secrets.
# Actual Django/AI/PayOS/email values are inherited from the existing .env.
# Do not change .env or copy it into an image. Never commit .env.docker.
# Optional: add these overrides to the private .env.docker; do not overwrite it.
# docker compose --env-file .env.docker up --build -d
DOCKER_HTTP_PORT=18081
DOCKER_MYSQL_CONNECT_HOST=host.docker.internal
# No MySQL container, automatic migration, seed, restore or AI indexing.
# Media and .rag-index are mounted from existing Windows directories.
# A Windows absolute path in an application env value must be reviewed before use.
# MYSQL_HOST stays unchanged from the Windows .env for RAG namespace compatibility.
# Only OPTIONS.host uses DOCKER_MYSQL_CONNECT_HOST for the actual connection.
# Keep the existing embedding profile/index; do not rename or rebuild SQLite files.
# HTTP localhost only. Preserve current .env DEBUG/cookie settings;
# if Secure cookies are required, configure HTTPS before authenticated acceptance.
