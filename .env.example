DJANGO_DEBUG=true
# Local direct-loopback image preview only; keep false on deployed servers.
DJANGO_LOCAL_MEDIA_ENABLED=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MYSQL_DATABASE=annhien_spa
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# SMTP: replace these examples in your local .env only.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=An Nhien Spa <noreply@example.com>
PASSWORD_RESET_TIMEOUT=3600

# Keys from An Nhien Spa channel only; fill locally in .env.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://127.0.0.1:8000/invoice.html
PAYOS_CANCEL_URL=http://127.0.0.1:8000/invoice.html
